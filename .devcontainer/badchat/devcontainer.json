// chat/bad ハンズオン用 Dev Container
// WSL 内の Docker で ../../chat/bad/docker-compose.yml の全サービスと作業用コンテナ (workspace) を起動する。
// 使い方: WSL で開いたリポジトリのルートを VS Code で開き、
//         「Dev Containers: Reopen in Container」で "badchat" を選ぶ。
{
  "name": "badchat",
  "dockerComposeFile": [
    "../../chat/bad/docker-compose.yml",
    "../compose.devcontainer.yml"
  ],
  "service": "workspace",
  "workspaceFolder": "/workspaces/multi-hole-cheese",
  "shutdownAction": "stopCompose",
  "remoteUser": "vscode",
  // .vscode/tasks.json のタスクが対象ハンズオンを判別するための環境変数
  "containerEnv": {
    "APP_DIR": "chat/bad",
    "APP_DB": "badchat"
  },
  "features": {
    // コンテナ内から WSL の Docker を操作する (タスクの ps / logs / restart 用)
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": false
    }
  },
  // ポートは docker-compose.yml の ports で WSL に公開済み (Windows の localhost から到達できる)
  //   チャット: http://badchat.example.com:8100  (chat/bad/launch_chrome.ps1 で起動した Chrome から)
  //   Adminer : http://localhost:8180
  "customizations": {
    "vscode": {
      "extensions": [
        "bmewburn.vscode-intelephense-client",
        "ms-azuretools.vscode-containers",
        "jebbs.plantuml",
        "davidanson.vscode-markdownlint",
        "mtxr.sqltools",
        "mtxr.sqltools-driver-mysql"
      ],
      "settings": {
        "sqltools.connections": [
          {
            "name": "badchat db",
            "driver": "MySQL",
            "server": "db",
            "port": 3306,
            "database": "badchat",
            "username": "user1",
            "password": "password1"
          }
        ]
      }
    }
  }
}
