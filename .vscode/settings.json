{
    "files.eol": "\n",
    "files.exclude": {
        "**/node_modules": true
    },
    // .puml と同じディレクトリに .svg を書き出す (例: chat/diagrams/network.puml -> chat/diagrams/network.svg)
    "plantuml.diagramsRoot": "",
    "plantuml.exportOutDir": ".",
    "plantuml.exportFormat": "svg",
    "plantuml.exportSubFolder": false,
    "markdownlint.config": {
        "MD033": false,
        "MD034": false,
        "MD040": false
    }
}
